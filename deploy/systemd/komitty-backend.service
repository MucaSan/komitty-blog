[Unit]
Description=Komitty Blog Backend (gRPC + grpc-gateway)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/komitty-blog/backend
EnvironmentFile=/opt/komitty-blog/.env
ExecStart=/opt/komitty-blog/backend/komitty-server
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
